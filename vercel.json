{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "BACKEND_INTERNAL_URL"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/admin", "destination": { "service": "backend" } },
    { "source": "/admin/(.*)", "destination": { "service": "backend" } },
    { "source": "/livewire/(.*)", "destination": { "service": "backend" } },
    { "source": "/filament/(.*)", "destination": { "service": "backend" } },
    { "source": "/css/filament/(.*)", "destination": { "service": "backend" } },
    { "source": "/js/filament/(.*)", "destination": { "service": "backend" } },
    { "source": "/fonts/filament/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ],
  "crons": [{ "path": "/api/v1/cron/schedule", "schedule": "* * * * *" }]
}
